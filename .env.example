# Local: SQLite file (created on first `npm run dev`).
DATABASE_URL="file:./dev.db"

# Production (Vercel): paste the Postgres URL from Vercel Storage / Neon.
# DATABASE_URL="postgresql://..."

# Cookie sessions. Any long random string. Required for live multi-device sync.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. Clerk / Auth0 / Twilio / email are not required.
# The app keeps join-code + optional household password on its own.
