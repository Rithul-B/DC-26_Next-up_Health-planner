# Production (Vercel): paste the Postgres URL from Vercel Storage / Neon.
# DATABASE_URL="postgresql://..."

# Cookie sessions. Any long random string. Required for live multi-device sync.
SESSION_SECRET="change-me-to-a-long-random-string"

